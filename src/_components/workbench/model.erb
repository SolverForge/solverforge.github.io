<div class="wb-model" data-workbench-page="<%= model["id"] %>">
  <h2 id="constraints">Constraints</h2>
  <p>
    <%= model["constraints"].size %> constraints in <%= groups.size %> groups:
    <%= counts["hard"] %> hard, <%= counts["medium"] %> medium and <%= counts["soft"] %> soft.
    Search them by name, group, level or meaning in the
    <a href="<%= explorer_url %>">constraint explorer</a>.
  </p>
  <% groups.each do |group, rules| %>
    <h3 id="<%= group_anchor(group) %>"><%= group %></h3>
    <ul class="wb-rules">
      <% rules.each do |rule| %>
        <li class="wb-rule" id="<%= anchor(rule) %>">
          <div class="wb-rule__head">
            <a class="wb-rule__name" href="#<%= anchor(rule) %>"><%= rule["name"] %></a>
            <span class="wb-level wb-level--<%= rule["level"] %>"><%= rule["level"] %></span>
            <% if off?(rule) %><span class="wb-flag">off unless weighted</span><% end %>
          </div>
          <p class="wb-rule__text"><%= rule["description"] %></p>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2 id="data">Data</h2>
  <p>
    A dataset is one JSON document. These are its tables, each at its JSON path,
    with every field the model reads; the Workbench data editor shows the same
    tables with a typed editor per field.
  </p>
  <% model["tables"].each do |table| %>
    <h3 id="table-<%= table["id"] %>"><%= table["label"] %> <code><%= table["path"] %></code></h3>
    <div class="wb-table-wrap">
      <table class="wb-table wb-table--fields">
        <thead><tr><th>Field</th><th>Label</th><th>Kind</th><th>Required</th><th>Values</th></tr></thead>
        <tbody>
          <% table["columns"].each do |column| %>
            <tr>
              <td><code><%= column["name"] %></code></td>
              <td><%= column["label"] %></td>
              <td><%= kind(column) %><% unless subfields(column).empty? %>: <code><%= subfields(column) %></code><% end %></td>
              <td><%= column["read_only"] ? "written by the solver" : (column["optional"] ? "optional" : "required") %></td>
              <td><%= values(column) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% unless model["parameters"].empty? %>
    <h2 id="parameters">Parameters</h2>
    <p>Settings of the model itself. A profile or a dataset sets them; the default applies otherwise.</p>
    <div class="wb-table-wrap">
      <table class="wb-table">
        <thead><tr><th>Parameter</th><th>Default</th><th>Meaning</th></tr></thead>
        <tbody>
          <% model["parameters"].each do |param| %>
            <tr>
              <td><code><%= param["name"] %></code><br><%= param["label"] %></td>
              <td><%= param["default"] %><%= " #{param["unit"]}" if param["unit"] && param["default"] %></td>
              <td><%= param["description"] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <h2 id="demo">Demo</h2>
  <% model["demos"].each do |demo| %>
    <p><strong><%= demo["name"] %></strong> (<code><%= demo["id"] %></code>): <%= demo["summary"] %></p>
  <% end %>
</div>
