<div class="wb-explorer" data-workbench-explorer>
  <div class="wb-explorer__controls">
    <label class="wb-explorer__search">
      <span class="wb-explorer__label">Search constraints</span>
      <input type="search" data-workbench-query autocomplete="off" spellcheck="false"
             placeholder="Name, group, level or what it means: rst btwn, overtime, parts">
    </label>
    <label class="wb-explorer__filter">
      <span class="wb-explorer__label">Model</span>
      <select data-workbench-model>
        <option value="">All four models</option>
        <% models.each do |model| %>
          <option value="<%= model["id"] %>"><%= model["name"] %></option>
        <% end %>
      </select>
    </label>
    <label class="wb-explorer__filter">
      <span class="wb-explorer__label">Level</span>
      <select data-workbench-level>
        <option value="">Every level</option>
        <% levels.each do |level| %>
          <option value="<%= level %>"><%= level.capitalize %></option>
        <% end %>
      </select>
    </label>
  </div>
  <p class="wb-explorer__status" data-workbench-status aria-live="polite"><%= rules.size %> constraints</p>
  <ol class="wb-explorer__list" data-workbench-list>
    <% rules.each do |model, rule| %>
      <li class="wb-hit" data-model="<%= model["id"] %>" data-level="<%= rule["level"] %>"
          data-name="<%= rule["name"] %>" data-group="<%= rule["group"] %>"
          data-model-name="<%= model["name"] %>" data-description="<%= rule["description"] %>">
        <div class="wb-rule__head">
          <a class="wb-rule__name" data-workbench-name href="<%= url(model, rule) %>"><%= rule["name"] %></a>
          <span class="wb-level wb-level--<%= rule["level"] %>" title="<%= meaning(rule["level"]) %>"><%= rule["level"] %></span>
          <% if off?(rule) %><span class="wb-flag">off unless weighted</span><% end %>
        </div>
        <p class="wb-hit__where"><%= model["name"] %> · <a href="<%= group_url(model, rule) %>"><%= rule["group"] %></a></p>
        <p class="wb-rule__text"><%= rule["description"] %></p>
      </li>
    <% end %>
  </ol>
  <p class="wb-explorer__empty" data-workbench-empty hidden>No constraint matches. Try fewer letters, or another model or level.</p>
</div>
