<section class="benchmark-charts" aria-label="<%= @problem.fetch('title') %> summary charts">
  <p class="benchmark-charts__ranking">Earliest feasible gate first; compare feasibility and quality within each gate. Runtime does not rank solutions.</p>
  <div class="benchmark-charts__legend">
    <% budgets.each do |budget| %>
      <span class="benchmark-charts__legend-item">
        <span class="benchmark-charts__swatch benchmark-charts__swatch--<%= budget %>s"></span>
        <%= budget %>-second budget
      </span>
    <% end %>
  </div>

  <div class="benchmark-charts__panels">
    <%# Feasibility first: a quality average over fewer feasible instances is
        not a win over a solver that solved them all. %>
    <figure class="benchmark-chart">
      <figcaption class="benchmark-chart__caption">
        <h3>Feasible results</h3>
        <p>Instances solved to a hard-feasible solution, out of <%= total_instances %>.</p>
      </figcaption>
      <div class="benchmark-chart__budgets">
      <% budgets.each do |budget| %>
        <div class="benchmark-chart__budget" data-budget="<%= budget %>">
        <h4><%= budget %>-second budget</h4>
        <ol class="benchmark-chart__rows">
        <% solvers(budget).each do |solver| %>
          <li class="benchmark-chart__row<%= ' benchmark-chart__row--solverforge' if solverforge?(solver) %>">
            <span class="benchmark-chart__label"><%= solver %></span>
            <span class="benchmark-chart__bars">
                <% row = summary(budget, solver) %>
                <% percent = feasible_percent(row) %>
                <span
                  class="benchmark-chart__track"
                  title="<%= solver %>, <%= budget %>s: <%= row ? "#{row.fetch('feasible')} of #{row.fetch('total')} feasible" : 'not recorded' %>"
                >
                  <% if percent %>
                    <span
                      class="benchmark-chart__bar benchmark-chart__bar--<%= budget %>s<%= ' benchmark-chart__bar--zero' if zero?(percent) %>"
                      style="--benchmark-bar-fill: <%= percent.round(2) %>%"
                      data-benchmark-feasible="<%= row.fetch('feasible') %>"
                      data-benchmark-total="<%= row.fetch('total') %>"
                    ></span>
                  <% else %>
                    <span class="benchmark-chart__bar benchmark-chart__bar--missing" data-benchmark-missing="true"></span>
                  <% end %>
                </span>
            </span>
            <span class="benchmark-chart__value">
                <% row = summary(budget, solver) %>
                <span><small><%= budget %>s</small> <%= row ? "#{row.fetch('feasible')}/#{row.fetch('total')}" : "—" %></span>
            </span>
          </li>
        <% end %>
        </ol>
        </div>
      <% end %>
      </div>
    </figure>

    <%# Each instance contributes only to its earliest observed feasible gate. %>
    <figure class="benchmark-chart">
      <figcaption class="benchmark-chart__caption">
        <h3>First feasible gate</h3>
        <p>Instances first observed feasible at this tested budget, out of <%= total_instances %>.
          Each instance counts once: earlier is better. Independent budget runs, not
          first-solution timestamps; late returns are retained. Never feasible:
          <% solvers(budgets.first).each_with_index do |solver, index| %><%= '; ' if index > 0 %><%= solver %> <%= @problem.fetch('first_feasible_gates').fetch(solver).fetch('never') %><% end %>.
        </p>
      </figcaption>
      <% if total_instances.positive? %>
      <div class="benchmark-chart__budgets">
      <% budgets.each do |budget| %>
        <div class="benchmark-chart__budget" data-budget="<%= budget %>">
        <h4><%= budget %>-second budget</h4>
        <ol class="benchmark-chart__rows">
        <% solvers(budget).each do |solver| %>
          <li class="benchmark-chart__row<%= ' benchmark-chart__row--solverforge' if solverforge?(solver) %>">
            <span class="benchmark-chart__label"><%= solver %></span>
            <span class="benchmark-chart__bars">
                <% row = summary(budget, solver) %>
                <% count = @problem.fetch('first_feasible_gates').fetch(solver).fetch('counts').fetch(budget.to_s) %>
                <% fill_percent = fill(count, total_instances) %>
                <span
                  class="benchmark-chart__track"
                  title="<%= solver %>: <%= count %> instances first feasible at the <%= budget %>s gate"
                >
                  <% if fill_percent %>
                    <span
                      class="benchmark-chart__bar benchmark-chart__bar--<%= budget %>s<%= ' benchmark-chart__bar--zero' if zero?(count) %>"
                      style="--benchmark-bar-fill: <%= fill_percent %>%"
                      data-benchmark-first-gate="<%= count %>"
                    ></span>
                  <% else %>
                    <span class="benchmark-chart__bar benchmark-chart__bar--missing" data-benchmark-missing="true"></span>
                  <% end %>
                </span>
            </span>
            <span class="benchmark-chart__value">
                <% row = summary(budget, solver) %>
                <span><small><%= budget %>s</small> <%= count %>/<%= total_instances %></span>
            </span>
          </li>
        <% end %>
        </ol>
        </div>
      <% end %>
      </div>
      <% end %>
    </figure>

    <%# Then quality. Read together with the panels above: the same solver can
        top this chart only where it stayed feasible. %>
    <figure class="benchmark-chart">
      <figcaption class="benchmark-chart__caption">
        <h3>Mean gap to reference</h3>
        <% if drawable_gaps? %>
          <p>
            Feasible results with a reference cost only. 0% matches the reference; lower is better.
            Rows follow feasibility-first ranking, not gap alone. Coverage and sample counts
            are shown on every row; means over different solved subsets are not like-for-like.
            <% if max_gap %>
              Bars are scaled to this problem's largest mean gap, <strong><%= format('%.2f%%', max_gap) %></strong>.
            <% end %>
          </p>
        <% else %>
          <p>
            This run's instances are not in the published reference set, so no solver has a
            mean gap to show. Validated mean costs are in the tables below;
            the published values cover other instances of this problem, not these.
          </p>
        <% end %>
      </figcaption>
      <% if drawable_gaps? %>
      <div class="benchmark-chart__budgets">
      <% budgets.each do |budget| %>
        <div class="benchmark-chart__budget" data-budget="<%= budget %>">
        <h4><%= budget %>-second budget</h4>
        <ol class="benchmark-chart__rows">
        <% solvers(budget).each do |solver| %>
          <li class="benchmark-chart__row<%= ' benchmark-chart__row--solverforge' if solverforge?(solver) %>">
            <span class="benchmark-chart__label"><%= solver %></span>
            <span class="benchmark-chart__bars">
                <% row = summary(budget, solver) %>
                <% gap = gap_percent(row) %>
                <% fill_percent = fill(gap, max_gap) %>
                <span
                  class="benchmark-chart__track"
                  title="<%= solver %>, <%= budget %>s: <%= gap ? "#{format('%.2f%%', gap)} mean gap over #{row.fetch('quality_samples')} samples" : 'no feasible result with a reference cost' %>"
                >
                  <% if fill_percent %>
                    <span
                      class="benchmark-chart__bar benchmark-chart__bar--<%= budget %>s"
                      style="--benchmark-bar-fill: <%= fill_percent %>%"
                      data-benchmark-gap="<%= gap.round(2) %>"
                    ></span>
                  <% else %>
                    <span class="benchmark-chart__bar benchmark-chart__bar--missing" data-benchmark-missing="true"></span>
                  <% end %>
                </span>
            </span>
            <span class="benchmark-chart__value">
                <% row = summary(budget, solver) %>
                <span><small><%= budget %>s</small> <%= row && row['gap_percent'] ? format('%.2f%%', row['gap_percent']) : "—" %></span>
            </span>
            <span class="benchmark-chart__context">
              <span><%= row.fetch('feasible') %>/<%= row.fetch('total') %> feasible · <%= row.fetch('quality_samples') %> gap samples</span>
              <% earlier = budgets.select { |gate| gate < budget } %>
              <% unless earlier.empty? %>
                <span>Earlier feasibility: <% earlier.each_with_index do |gate, index| %><%= ' · ' if index > 0 %><% previous = summary(gate, solver) %><%= gate %>s <%= previous.fetch('feasible') %>/<%= previous.fetch('total') %><% end %></span>
              <% end %>
            </span>
          </li>
        <% end %>
        </ol>
        </div>
      <% end %>
      </div>
      <% end %>
    </figure>
  </div>
</section>
